{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vellum",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "API_URL": "https://vellum-journal-server.onrender.com",
    "NEXT_PUBLIC_API_URL": "https://vellum-journal-server.onrender.com",
    "NEXT_PUBLIC_SOCKET_URL": "https://vellum-journal-server.onrender.com"
  }
}
